<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đang chờ NFC... Áp thẻ vào mặt sau điện thoại."
            android:textStyle="bold"
            android:textSize="16sp"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/chkCccd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chế độ đọc CCCD gắn chip (thay cho thẻ ngân hàng)" />

        <LinearLayout
            android:id="@+id/llCccd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khóa mở thẻ: 3 thông tin in ở dòng MRZ mặt sau CCCD. Dán 2 dòng MRZ đầu rồi bấm Điền, hoặc nhập tay."
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnMrzOcr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chụp mặt sau CCCD, OCR MRZ tự điền" />

            <EditText
                android:id="@+id/etMrz1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dòng MRZ 1 (30 ký tự)"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etMrz2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Dòng MRZ 2 (30 ký tự)"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Điền tự động từ MRZ" />

            <EditText
                android:id="@+id/etDoc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số giấy tờ (9 ký tự trong MRZ dòng 1)"
                android:fontFamily="monospace"
                android:inputType="textCapCharacters|textNoSuggestions" />

            <EditText
                android:id="@+id/etDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ngày sinh YYMMDD"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="6" />

            <EditText
                android:id="@+id/etDoe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ngày hết hạn YYMMDD"
                android:fontFamily="monospace"
                android:inputType="number"
                android:maxLength="6" />

            <CheckBox
                android:id="@+id/chkExtra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Đọc thêm DG11/DG12/DG13 (thông tin bổ sung)" />

            <CheckBox
                android:id="@+id/chkPhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đọc ảnh chân dung DG2 (chậm hơn)" />

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="160dp"
                android:layout_height="200dp"
                android:scaleType="fitStart"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnOcr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chụp mặt thẻ (OCR)" />

            <Button
                android:id="@+id/btnClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa log" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExport"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xuất PDF" />

            <Button
                android:id="@+id/btnPrint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In báo cáo" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/chkFullPan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hiện đầy đủ số thẻ trong báo cáo thẻ ngân hàng (mặc định che bớt)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Kiểm tra chính danh (đối chiếu khuôn mặt)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gửi ảnh chân dung trên thẻ (từ CCCD hoặc chụp thẻ sinh viên) và ảnh chụp trực tiếp người cầm thẻ tới FaceID service của bạn (InsightFace, tự host) để so khớp."
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etFaceUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Địa chỉ FaceID service, vd http://192.168.1.10:8001"
            android:inputType="textUri"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etFaceKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="X-API-Key"
            android:inputType="textPassword"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ảnh chân dung trên thẻ"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivRefPhoto"
                    android:layout_width="110dp"
                    android:layout_height="140dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE" />

                <Button
                    android:id="@+id/btnCaptureRef"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:text="Chụp ảnh thẻ SV" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ảnh người cầm thẻ (live)"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivLivePhoto"
                    android:layout_width="110dp"
                    android:layout_height="140dp"
                    android:scaleType="centerCrop"
                    android:background="#EEEEEE" />

                <Button
                    android:id="@+id/btnCaptureLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:text="Chụp ảnh live" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnVerifyFace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kiểm tra chính danh" />

        <TextView
            android:id="@+id/tvFaceResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Xuất báo cáo kết hợp: thẻ ngân hàng/SV + CCCD + FaceID (đã đọc/kiểm tra ở trên)"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportCombined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xuất PDF kết hợp" />

            <Button
                android:id="@+id/btnPrintCombined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In báo cáo kết hợp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCompare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Bước 1: áp thẻ để đọc chip. Bước 2: chụp mặt thẻ có số thẻ và hạn dùng (đặt trên nền tối, đủ sáng, không chói)."
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
